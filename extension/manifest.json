{
  "manifest_version": 3,
  "name": "n8n MCP Bridge",
  "version": "2.0.0",
  "description": "Zero-config n8n integration for AI agents",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://*.n8n.io/*",
    "*://*.n8n.cloud/*",
    "*://*.hully.one/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.n8n.io/*", "*://*.n8n.cloud/*", "*://*.hully.one/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "n8n MCP Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
