{
  "name": "@anatolykoptev/n8n-mcp-agent",
  "description": "Autonomous AI agent for n8n workflow automation with credential factories, execution helpers, 4343+ workflow templates, and specialized sub-agents",
  "version": "2.0.0",
  "type": "module",
  "bin": {
    "n8n-mcp-agent": "build/main.js"
  },
  "files": [
    "build",
    "agents",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Anatoly Koptev",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolykoptev/n8n-mcp-agent.git"
  },
  "bugs": {
    "url": "https://github.com/anatolykoptev/n8n-mcp-agent/issues"
  },
  "homepage": "https://github.com/anatolykoptev/n8n-mcp-agent#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "n8n",
    "mcp",
    "automation",
    "workflow",
    "ai-agent",
    "autonomous",
    "llm",
    "claude",
    "modelcontextprotocol",
    "workflow-templates",
    "credential-management"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/main.js",
    "start": "node build/main.js",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
